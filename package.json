{
  "name": "subtrk",
  "version": "0.1.20",
  "description": "One command for all your AI subscription quotas – agent-first usage tracking across Claude, GLM, Alibaba, Google, OpenCode Zen and OpenRouter",
  "bin": {
    "subtrk": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "author": "ChaosChild",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaosChild/subtrk.git"
  },
  "bugs": {
    "url": "https://github.com/ChaosChild/subtrk/issues"
  },
  "homepage": "https://github.com/ChaosChild/subtrk#readme",
  "keywords": [
    "ai",
    "quota",
    "usage",
    "rate-limits",
    "claude",
    "glm",
    "alibaba",
    "google-gemini",
    "openrouter",
    "opencode",
    "cli",
    "agents",
    "axi"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
